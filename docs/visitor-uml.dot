digraph VisitorPattern {
    graph [
        rankdir=TB,
        bgcolor="white",
        pad=0.12,
        nodesep=0.30,
        ranksep=0.55,
        splines=polyline,
        outputorder=edgesfirst,
        fontname="Times New Roman,"
    ];
    node [shape=plain, fontname="Times New Roman,", fontsize=12];
    edge [fontname="Times New Roman,", fontsize=11, color="#000000", penwidth=1.1, arrowsize=0.85];

    Element [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#000000">
            <TR><TD BGCOLOR="white"><FONT POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT><BR/><B>Element</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ getName(): String<BR ALIGN="LEFT"/>+ accept(Visitor): void</TD></TR>
        </TABLE>
    >];

    "Node" [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#000000">
            <TR><TD BGCOLOR="white"><FONT POINT-SIZE="10">&lt;&lt;abstract&gt;&gt;</FONT><BR/><B><I>Node</I></B></TD></TR>
            <TR><TD ALIGN="LEFT">- name: String<BR ALIGN="LEFT"/>- parent: DirectoryNode</TD></TR>
            <HR/>
            <TR><TD ALIGN="LEFT">+ getName(): String<BR ALIGN="LEFT"/>+ getParent(): DirectoryNode</TD></TR>
        </TABLE>
    >];

    FileNode [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#000000">
            <TR><TD BGCOLOR="white"><B>FileNode</B></TD></TR>
            <TR><TD ALIGN="LEFT">- size: long</TD></TR>
            <HR/>
            <TR><TD ALIGN="LEFT">+ getSize(): long<BR ALIGN="LEFT"/>+ accept(Visitor): void</TD></TR>
        </TABLE>
    >];

    DirectoryNode [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#000000">
            <TR><TD BGCOLOR="white"><B>DirectoryNode</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ addChild(Node): void<BR ALIGN="LEFT"/>+ getChildren(): List&lt;Node&gt;<BR ALIGN="LEFT"/>+ accept(Visitor): void</TD></TR>
        </TABLE>
    >];

    Visitor [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#000000">
            <TR><TD BGCOLOR="white"><FONT POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT><BR/><B>Visitor</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ visit(FileNode): void<BR ALIGN="LEFT"/>+ visit(DirectoryNode): void</TD></TR>
        </TABLE>
    >];

    TotalSizeVisitor [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#000000">
            <TR><TD BGCOLOR="white"><B>TotalSizeVisitor</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ calculate(Element): long<BR ALIGN="LEFT"/>+ visit(FileNode): void<BR ALIGN="LEFT"/>+ visit(DirectoryNode): void</TD></TR>
        </TABLE>
    >];

    SearchVisitor [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#000000">
            <TR><TD BGCOLOR="white"><B>SearchVisitor</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ search(Element): List&lt;String&gt;<BR ALIGN="LEFT"/>+ visit(FileNode): void<BR ALIGN="LEFT"/>+ visit(DirectoryNode): void</TD></TR>
        </TABLE>
    >];

    StatisticsVisitor [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#000000">
            <TR><TD BGCOLOR="white"><B>StatisticsVisitor</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ collect(Element): void<BR ALIGN="LEFT"/>+ getFileCount(): int<BR ALIGN="LEFT"/>+ getDirectoryCount(): int<BR ALIGN="LEFT"/>+ getMaxDepth(): int<BR ALIGN="LEFT"/>+ visit(FileNode): void<BR ALIGN="LEFT"/>+ visit(DirectoryNode): void</TD></TR>
        </TABLE>
    >];

    { rank=same; FileNode; DirectoryNode; }
    { rank=same; TotalSizeVisitor; SearchVisitor; StatisticsVisitor; }

    Element -> "Node" [dir=back, arrowtail=empty, style=dashed, label="  implements\n  Element"];
    "Node" -> FileNode [dir=back, arrowtail=empty, label="  extends Node"];
    "Node" -> DirectoryNode [dir=back, arrowtail=empty, label="  extends Node"];
    DirectoryNode:ne -> "Node":e [
        dir=both,
        arrowtail=diamond,
        arrowhead=none,
        constraint=false,
        label="owns child nodes",
        headlabel="0..*",
        taillabel="0..1",
        labeldistance=2.0,
        labelangle=45
    ];

    FileNode -> Visitor [style=dashed, arrowhead=vee, label="  accept() calls\n  visit(FileNode)"];
    DirectoryNode -> Visitor [style=dashed, arrowhead=vee, label="  accept() calls\n  visit(DirectoryNode)"];

    Visitor -> TotalSizeVisitor [dir=back, arrowtail=empty, style=dashed, label="  implements\n  Visitor"];
    Visitor -> SearchVisitor [dir=back, arrowtail=empty, style=dashed, label="  implements\n  Visitor"];
    Visitor -> StatisticsVisitor [dir=back, arrowtail=empty, style=dashed, label="  implements\n  Visitor"];
}
